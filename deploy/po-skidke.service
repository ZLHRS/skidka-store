[Unit]
Description=Po Skidke web application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=po-skidke
Group=po-skidke
WorkingDirectory=/opt/po-skidke
Environment=NODE_ENV=production
EnvironmentFile=/etc/po-skidke.env
ExecStart=/usr/bin/node /opt/po-skidke/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
StateDirectory=po-skidke
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/po-skidke

[Install]
WantedBy=multi-user.target
